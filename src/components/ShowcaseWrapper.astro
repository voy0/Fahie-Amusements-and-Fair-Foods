---
import ImageShowcase from './ImagesShowcase.astro';

interface ImageItem {
  src: string;
  alt: string;
}

interface Props {
  title: string;
  images: ImageItem[];
}

const { title, images } = Astro.props;
---

<article class="showcase-wrapper">
  <div class="images">
    <ImageShowcase images={images} />
  </div>
  <div class="tagline">
    <h1>{title}</h1>
  </div>
</article>

<style>
  .showcase-wrapper {
    position: relative;
    width: 40%;
    height: auto;
    display: flex;
    flex-direction: column;
    justify-content: top;
    align-items: center;
  }

  .images {
    order: 1;
    width: min(35vw, 35rem);
    height: min(35vw, 35rem);
  }

  .tagline {
    order: 0;
    margin: 2rem 0 1rem;
    text-align: center;
    line-height: 150%;
    font-weight: 200;
    letter-spacing: 0.2rem;
    font-family: var(--coiny);
    text-shadow: 0 0 5px var(--faff-orange),
      0 0 10px var(--faff-orange),
      0 0 15px var(--faff-orange);
  }

  @media (max-width: 600px) {
    .images {
      width: 85vw;
      height: 85vw;
    }
  }
</style>
