---
// src/components/Hero.astro
import { getImage } from 'astro:assets';

import mobileBg from '../assets/hero-mobile.jpg';
import desktopBg from '../assets/hero-desktop.jpg';
import ContactForm from '../components/ContactForm.astro';

const mobileImg = await getImage({ src: mobileBg, format: 'webp', width: 600 });
const desktopImg = await getImage({
  src: desktopBg,
  format: 'webp',
  width: 1920,
});
---
<div class="hero-background">
  <picture class="hero-image">
    <source media="(max-width: 600px)" srcset={mobileImg.src} />
    <img
      src={desktopImg.src}
      alt="Fahie Amusements and Fairfoods at night, with fireworks"
      width={desktopImg.attributes.width}
      height={desktopImg.attributes.height}
      loading="lazy"
      decoding="async"
    />
  </picture>
  <div class="hero-gradient" id="hero-gradient1"></div>
  <div class="hero-gradient" id="hero-gradient2"></div>
</div>

<style>
     .hero-background {
    position: fixed;
    inset: 0;
  }

  
  .hero-image {
    z-index: 0;
    display: block;
    width: 100%;
    height: 100%; 
  }

  /* This applies to BOTH desktop and mobile by default */
  .hero-image img {
     z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center; /* The Magic Fix */
  }

  .hero-gradient {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  #hero-gradient1 {
    background: linear-gradient(
      to right,
      rgba(0, 0, 0, 60%) 1%,
      rgba(0, 0, 0, 0) 35%,
      rgba(0, 0, 0, 0) 50%,
      rgba(0, 0, 0, 0) 65%,
      rgba(0, 0, 0, 60%) 99%
    );
  }

  #hero-gradient2 {
    background: linear-gradient(
      to top,
      rgb(0, 0, 0) 0%,
      rgba(0, 0, 0, 0) 35%,
      rgba(0, 0, 0, 0) 50%,
      rgba(0, 0, 0, 0) 85%,
      rgba(0, 0, 0) 100%
    );
  }
  @media(max-width: 600px){

    .hero-background {
      inset: 0;
    }

    .hero-image {
      position: absolute;
      inset: 0;
    }

  }
</style>