---
interface Props {
  title: string;
  separate?: boolean;
}
const { title, separate = false } = Astro.props;
---

<div class="container">
  <div class="wrapper">
    <div class="title">{title}</div>
    {separate && <div class="separator"></div>}
  </div>
</div>

<style>
  
  .container {
    z-index: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    color: rgb(240, 233, 233);
    text-shadow: 0 0 5px var(--faff-orange),
                 0 0 10px var(--faff-orange),
                 0 0 15px var(--faff-orange),
                 0 0 5px rgb(0, 0, 0),
                 0 0 10px rgb(0, 0, 0),
                 0 0 15px rgb(0, 0, 0),
                 0 0 20px rgb(0, 0, 0),
                 -1px -1px 1px rgb(255, 0, 0),        /* Deep black cutout on top-left */
              -1px 1px 1px rgb(255, 0, 0), 
              1px -1px 1px rgb(255, 0, 0), 
              1px 1px 1px rgb(255, 0, 0);
  }

  .wrapper {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    margin-top: 3rem;
    gap: 0.5rem;
    width: 100%;
  }
  .title {
    font-size: var(--fs4);
    font-weight: 400;
    padding: 0 0 0 1rem;
    text-transform: uppercase;
  }
  .separator {
    z-index: 100;
    width: 100%;
    height: 0;
    border-bottom: 1px solid var(--faff-orange);
    box-shadow: 0 0 5px var(--faff-orange),
                0 0 10px var(--faff-orange),
                0 0 15px var(--faff-orange);
  }

  @media (max-width: 600px) {
    .title {
      font-size: 4em;
    }
  }
  </style>