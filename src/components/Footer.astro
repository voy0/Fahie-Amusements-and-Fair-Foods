---
// src/components/Footer.astro
---

<footer class="footer-container">
  <div class="footer-content">
    
    <!-- Column 1: Brand & Contact -->
     <div class="footer-column">
      <div class="logo">
      <a href={import.meta.env.BASE_URL}>
        <img src="fafficon.svg" alt="Fahie Amusements & Fair Foods home" />
      </a>
    </div>
     </div>
    <div class="footer-column">
      <h3>Fahie Amusements</h3>
      <p>Serving New England with Fun & Flavor!</p>
      <a href="tel:+15555555555" class="contact-link">(555) 555-5555</a>
      <a href="mailto:info@example.com" class="contact-link">info@example.com</a>
    </div>

    <!-- Column 2: Quick Links -->
    <div class="footer-column">
      <h3>Explore</h3>
      <a href={`${import.meta.env.BASE_URL}foods`}>Fair Foods</a>
      <a href={`${import.meta.env.BASE_URL}amusements`}>Amusements</a>
      <a href={`${import.meta.env.BASE_URL}upcoming`}>Upcoming Events</a>
      <a href={`${import.meta.env.BASE_URL}about`}>About Us</a>
    </div>

    <!-- Column 3: Socials -->
    <div class="footer-column">
      <h3>Follow Us</h3>
      <a href="#">Facebook</a>
      <a href="#">Instagram</a>
    </div>

  </div>

  <div class="footer-bottom">
    <p>&copy; {new Date().getFullYear()} Fahie Amusements & Fair Foods. All rights reserved.</p>
  </div>
</footer>

<style>
  .logo a img{
    width: 10rem;
  }
  .footer-container {
    margin-top: 10vh;
    z-index: 100;
    position: relative;
    bottom: 0;
    background-color: var(--faff-darkblue, rgb(10, 10, 21));
    color: white;
    padding: 3rem 1rem 1rem 1rem;
    font-family: var(--comfortaa);
    border-top: 1px solid var(--faff-orange); /* Adds a nice neon trim at the top */
  }

  .footer-content {
    z-index: 100;

    display: flex;
    flex-wrap: wrap;
    justify-content: space-around;
    max-width: 1200px;
    margin: 0 auto;
    gap: 2rem;
  }

  .footer-column {
    z-index: 100;
    
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-column h3 {
    z-index: 100;

    color: var(--faff-orange);
    margin-bottom: 1rem;
  }

  .footer-column a {
    z-index: 100;

    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-column a:hover {
    z-index: 100;

    color: white;
    text-shadow: 0 0 5px var(--faff-orange);
  }

  .contact-link {
    z-index: 100;

    font-weight: bold;
  }

  .footer-bottom {
    z-index: 100;

    text-align: center;
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.5);
  }
</style>