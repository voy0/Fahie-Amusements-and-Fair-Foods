---
// src/components/Footer.astro
import ContactButton from "./ContactButton.astro";
const contactHref = Astro.url.pathname === '/' ? '#contact-form' : '/#contact-form';

---

<footer class="footer-container">
  <div class="footer-content">
    <!-- Column 1: Brand & Contact -->
    <div class="footer-column">
      <div class="logo">
        <a href={import.meta.env.BASE_URL}>
          <img src="fafficon.svg" alt="Fahie Amusements & Fair Foods home" />
        </a>
      </div>
    </div>
    <div class="footer-column">
      <h3>Fahie Amusements & Fair Foods</h3>
      <p>Serving New England with Fun & Flavor!</p>
      <a href="mailto:thefahies@fahieamusements.com" class="contact-link"
        >thefahies@fahieamusements.com</a
      >
    </div>

    <!-- Column 2: Quick Links -->
    <div class="footer-column">
      <h3>Explore</h3>
      <a href={`${import.meta.env.BASE_URL}foods`}>Fair Foods</a>
      <a href={`${import.meta.env.BASE_URL}amusements`}>Amusements</a>
      <a href={`${import.meta.env.BASE_URL}upcoming`}>Upcoming Events</a>
      <a href={`${import.meta.env.BASE_URL}about`}>About Us</a>
    </div>
<div class="footer-column contact-us">
      <ContactButton href={contactHref} >Contact us!</ContactButton>
    </div>
    <!-- Column 3: Socials -->
    <div class="footer-column">
      <h3>Follow Us</h3>
      <a
        class="social-link"
        href="https://www.facebook.com/profile.php?id=100084158719843"
        aria-label="Facebook"
      >
        <svg
          class="social-icon"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M14 8h3V4h-3c-3.3 0-5 1.7-5 5v3H6v4h3v8h4v-8h3l1-4h-4V9c0-.7.3-1 1-1Z"
            fill="currentColor"></path>
        </svg>
      </a>
    </div>

    <!-- Column 4: Contact -->
    
  </div>

  <div class="footer-bottom">
    <p>
      &copy; {new Date().getFullYear()} Fahie Amusements & Fair Foods. All rights
      reserved.
    </p>
  </div>
</footer>

<style>
  .logo a img {
    width: 10rem;
  }
  .footer-container {
    margin-top: 10vh;
    z-index: 100;
    position: relative;
    bottom: 0;
    background-color: var(--faff-darkblue, rgb(10, 10, 21));
    color: white;
    padding: 3rem 1rem 1rem 1rem;
    font-family: var(--comfortaa);
    border-top: 1px solid var(--faff-orange); /* Adds a nice neon trim at the top */
  }

  .footer-content {
    z-index: 100;

    display: flex;
    flex-wrap: wrap;
    justify-content: space-around;
    max-width: 1200px;
    margin: 0 auto;
    gap: 2rem;
  }

  .footer-column {
    z-index: 100;

    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-column h3 {
    z-index: 100;

    color: var(--faff-orange);
    margin-bottom: 1rem;
  }

  .footer-column a {
    z-index: 100;

    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-column a:hover {
    z-index: 100;

    color: white;
    text-shadow: 0 0 5px var(--faff-orange);
  }

  .contact-link {
    z-index: 100;

    font-weight: bold;
  }

  .social-icon {
    width: 4rem;
    height: 4rem;
    color: var(--faff-orange);
    background: transparent;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 6rem;
    height: 6rem;
    border-radius: 0.75rem;
    background-color: rgba(0, 0, 0, 0.35);
  }

 

  .footer-bottom {
    z-index: 100;

    text-align: center;
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.5);
  }
  .contact-us{
    align-items: center;
    justify-content: center;
  }
  @media (max-width: 600px) {
    .footer-column{
      padding: 3rem 0;
    }
    .social-link {
      font-size: 1.5em;
      width: 9rem;
      height: 9rem;
    }
    .footer-container {
      padding: 10rem 3rem 1rem 3rem;
    }
    .logo a img {
      width: 20rem;
    }
    div {
      font-size: 3rem;
    }
    .footer-bottom{
      
      font-size: 2rem;
    }
  }
</style>
