---
import ContactForm from '../components/ContactForm.astro';
import smokingSipsVideo from '../assets/smoking_sips_cut.mp4';
---

<div class="container">
    <div class="wrapper">
        <ContactForm />

        <video
            class="smoking-sips-video"
            src={smokingSipsVideo}
            autoplay
            muted
            loop
            playsinline
            aria-hidden="true"
        ></video>
    </div>
</div>


<style>
    .container{
        position: relative;
        top: 0%;
        width: 100%;
        height: min-content;
        display: flex;
        justify-content: center;
        align-items: top;
    }
    .wrapper{
        position: relative;
        width: 100%;
        height: 100%;
        border-radius: 40px;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
        /* background-color: var(--bg-blue); */
    }
    .smoking-sips-video{
        z-index: 100;
        margin: 1rem;
        border-radius: 2rem;
        width: 300px;
        height: auto;
        object-fit: cover;
        pointer-events: none;
    }
    @media (min-width:1200px){
        .container{
            top: -10vw;
            font-size: 1.6rem;
        }
    }
    @media (max-width:600px) {
       .wrapper{
        flex-direction: column;
        width: 100%;
        border-radius: 20px;
    }
    .smoking-sips-video{
        margin-top: 5rem;
        width: 60%;
        height: auto;
        border-radius: 1rem;
    }
    .container{
        margin-top: -20%;
    }
    }
    @media (max-width:400px) {
        .container{
            margin-top: 0%;
        }
    }
    @media(max-height:550px){
        .container{
            margin-top: 10%;
        }
    }
</style>