---
import ContactForm from '../components/ContactForm.astro';
import smokingSipsVideo from '../assets/smoking_sips_cut.mp4';
---

<div class="container">
  <div class="wrapper">
    <ContactForm />
    <iframe
      src="https://www.facebook.com/plugins/likebox.php?href=https%3A%2F%2Fwww.facebook.com%2F100084158719843&width=500&&adapt_container_width=true&colorscheme=dark&show_faces=false&border_color&stream=true&header=true&height=435"
      scrolling="yes"
      allowtransparency="true"
      frameborder="0"
      title="Facebook posts"></iframe>

    <video
      class="smoking-sips-video"
      src={smokingSipsVideo}
      autoplay
      muted
      loop
      playsinline
      aria-hidden="true"></video>
  </div>
</div>

<style>
  iframe {
    display: block;
    margin: 0 auto 2rem;
    z-index: 100;
    border: none;
    overflow: hidden;
    width: min(600px, 100% - 4rem);
    height: 550px;
    background: rgb(2, 2, 2);
    color-scheme: dark;
    padding: 1rem;
    border-radius: 3rem;
  }
  .container {
    position: relative;
    top: 0%;
    width: 100%;
    height: min-content;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  .wrapper {
    position: relative;
    width: 100%;
    max-width: 1000px;
    height: 100%;
    border-radius: 40px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    /* background-color: var(--bg-blue); */
  }
  .smoking-sips-video {
    z-index: 100;
    margin: 1rem;
    border-radius: 2rem;
    width: 300px;
    height: auto;
    object-fit: cover;
    pointer-events: none;
  }
  @media (min-width: 1200px) {
    .container {
      top: -10vw;
      font-size: 1.6rem;
    }
  }
  @media (max-width: 600px) {
    iframe{
        display:none;
    }
    .wrapper {
      flex-direction: column;
      width: 100%;
      border-radius: 20px;
    }
    .smoking-sips-video {
      margin-top: 5rem;
      width: 60%;
      height: auto;
      border-radius: 1rem;
    }
    .container {
      margin-top: -20%;
    }
  }
  @media (max-width: 400px) {
    .container {
      margin-top: 0%;
    }
  }
  @media (max-height: 550px) {
    .container {
      margin-top: 10%;
    }
  }
</style>
