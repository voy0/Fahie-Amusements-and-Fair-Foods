--- 
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
import HeroBackground from '../components/HeroBackgroundFixed.astro';
import ShowcaseWrapper from '../components/ShowcaseWrapper.astro';
import Footer from '../components/Footer.astro';
import kiddyStriker1 from '../assets/placards/kiddy_striker1.jpg';

const img_kiddy_striker = [{ src: kiddyStriker1.src, alt: 'Kiddy Striker' }];

const amusement_showcases = [
    { title: 'Kiddy Striker', images: img_kiddy_striker },
];

---

<Layout>
<Header pageNumber={2}/>
<HeroBackground/>
<div class="container">
    {amusement_showcases.map((showcase) => (
        <ShowcaseWrapper title={showcase.title} images={showcase.images} />
    ))}
</div>
</Layout>
<Footer/>

<style>
  .container {
    margin-top: 10rem;
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    justify-content: center;
    align-items: center;
  }

  .showcase-wrapper {
    flex: 1 1 40rem;
    max-width: 55rem;
  }
  @media (max-width: 600px) {
    .container {
      margin-top: 15rem;
      flex-direction: column;
      min-height: 80vh;
    }
  }
</style>
