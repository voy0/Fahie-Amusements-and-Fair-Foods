---

<Layout>
<HeroBackground/>
<Header pageNumber={1}/>
<div class="container">
    {food_showcases.map((showcase) => (
        <ShowcaseWrapper title={showcase.title} subtitle={showcase.subtitle} images={showcase.images} />
    ))}
    <article class="coming-soon-placard">
        <p class="coming-soon-label">Coming Soon</p>
        <h1>2027</h1>
        <p class="coming-soon-intro">Two new joints are coming to the fair.</p>
        <div class="coming-soon-joints">
            <span>Ice Cream Joint</span>
            <span>Pickle Joint</span>
        </div>
    </article>
</div>
<Footer/>
</Layout>

<style>
    .container{
        margin-top: 10rem;
        width: 100%;
        height: auto;
        display: flex;
        flex-wrap: wrap;
        gap: 2rem;
        justify-content: center;
        align-items: center;
    }
    .showcase-wrapper {
        max-width: 80%;
    }
    .coming-soon-placard {
        position: relative;
        z-index: 200;
        width: min(80%, 35rem);
        margin: 2rem 1rem;
        padding: 2.5rem 2rem;
        border: 0.3rem solid var(--faff-orange);
        border-radius: 1rem;
        background: var(--faff-darkblue);
        color: white;
        text-align: center;
        box-shadow: 0 0 1.5rem rgba(0, 0, 0, 0.45);
        font-family: var(--coiny);
        text-shadow: 0 0 5px var(--faff-orange),
            0 0 10px var(--faff-orange);
    }
    .coming-soon-label,
    .coming-soon-intro,
    .coming-soon-placard h1 {
        margin: 0;
    }
    .coming-soon-label {
        font-size: 1.4rem;
        letter-spacing: 0.2rem;
        text-transform: uppercase;
    }
    .coming-soon-placard h1 {
        margin-top: 0.5rem;
        font-size: clamp(3rem, 8vw, 5rem);
        line-height: 1;
    }
    .coming-soon-intro {
        margin-top: 1rem;
        font-family: var(--comfortaa);
        font-size: 1rem;
        text-shadow: none;
    }
    .coming-soon-joints {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem;
        margin-top: 1.5rem;
        font-family: var(--comfortaa);
        font-size: 1rem;
        font-weight: 700;
        text-shadow: none;
    }
    .coming-soon-joints span {
        padding: 0.75rem 1rem;
        border: 0.15rem solid var(--faff-orange);
        border-radius: 999px;
    }
    @media (max-width: 600px) {
        .container{
            margin-top: 15rem;
            flex-direction: column;
            min-height: 80vh;
        }
        .coming-soon-placard {
            width: 80vw;
        }
       
    }
</style>
