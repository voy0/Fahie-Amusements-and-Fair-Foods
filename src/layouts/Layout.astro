</html>

<style is:global>
  :root {
    /* ADDED: Recreating your CSS font variables manually */
    --comfortaa: 'Comfortaa', sans-serif;
    --coiny: 'Coiny', system-ui;

    /* Your existing variables */
    --faff-orange: rgb(236, 94, 26);
    --faff-blue: rgb(37, 56, 112);
    --faff-darkblue: rgb(20, 20, 40);
    --bg-blue: rgb(18, 21, 43);
    --fs1: 0.6rem;
    --fs2: 1rem;
    --fs3: 1.6rem;
    --fs4: 2.6rem;
    --fs5: 4.25rem;
    --fs6: 6.9rem;
    --fs7: 10.5rem;
    --fs8: 16.5rem;
    --fs9: 25.5rem;
  }
  
  html,
  body {
    background-color: black;
    color: white;
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    font-size: 1vw;
  }

  html {
    scroll-behavior: smooth;
  }

  div {
    font-family: var(--comfortaa);
  }
  
  @media (min-width: 1200px){
      html {
        font-size: clamp(8px, 0.9em, 16px);
      }
  }
  @media(max-height: 650px){
      html {
        font-size: 3px;
      }
  }
</style>