<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="fafficon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- ADDED: Standard Google Fonts connection -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Coiny&family=Comfortaa:wght@300..700&display=swap" rel="stylesheet">
    
    <title>Fahie Amusements & Fair Foods</title>
