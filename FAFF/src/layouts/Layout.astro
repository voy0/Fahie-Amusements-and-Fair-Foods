---
import { Font } from 'astro:assets';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="fafficon.svg" />
    <!-- <link rel="icon" href="/fafficon.ico" /> -->
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--comfortaa" preload />
    <Font cssVariable="--coiny" preload />
    

    <title>Fahie Amusements & Fair Foods</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root{
    --faff-orange: rgb(236, 94, 26);
    --faff-blue: rgb(37, 56, 112);
    --faff-darkblue: rgb(20, 20, 40);
    --bg-blue: rgb(18, 21, 43);
    --fs1: 0.6rem;
    --fs2: 0.9rem;
    --fs3: 1.2rem;
    --fs4: 1.5rem;
    --fs5: 1.8rem;
  }
  html,
  body {
    background-color: black;
    color: white;
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    font-size: 1vw;
  }
  

  html {
    scroll-behavior: smooth;
  }

  div{
    font-family: var(--comfortaa)
  }
  @media (min-width: 1200px){
      html{
        font-size:clamp(8px, 0.9em,16px);
      }
    }
</style>
