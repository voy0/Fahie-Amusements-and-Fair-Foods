---
interface Props {
  title: string;
  month: string;
  day: string | number;
  hoursFrom?: string;  /* The ? means "optional" */
  hoursTo?: string;
  locationName?: string;
  mapUrl?: string;
  description?: string;
}

const { 
  title, 
  month, 
  day, 
  hoursFrom,
  hoursTo,
  locationName, 
  mapUrl, 
  description 
} = Astro.props;

---

<div class="event">
    <div class="date">
        <div class="month">{month}</div>
        <div class="day"><div class="day-wrapper">{day}</div></div>
        <div class="hours">{hoursFrom} - {hoursTo}</div>
    </div>

    <div class="w1">
        <div class="title">{title}</div>
        <a
            class="location"
            href={mapUrl}
            aria-label={`Open ${locationName} in maps`}
        >
            <svg class="location-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 21s7-6.1 7-12a7 7 0 1 0-14 0c0 5.9 7 12 7 12Z" />
                <circle cx="12" cy="9" r="2.25" />
            </svg>
            <span>{locationName}</span>
        </a>
        <div class="description">{description}</div>
    </div>
   
</div>

<style>
    :root{
        --event-size: 5rem;
        --event-font-size: calc(0.1 * var(--event-size));
    }
    .event{
        font-size: var(--event-font-size);
        position: relative;
        z-index: 1;
        border: 2px solid var(--faff-orange);
        width: 100%;
        height: var(--event-size);
        background-color: var(--bg-blue);
        border-radius: 1.25rem;
        overflow: hidden;
        display: flex;
    }
    .date{
        background-color: rgb(56, 40, 25);
        height: 100%;
        width: var(--event-size);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }
    .date div{
        text-align: center;
        width: 100%;
    }
    .day{
        height: 60%;
        font-size: calc(0.4 * var(--event-size));
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .day-wrapper{
        width: min-content;
        height: min-content;
    }
    .w1{
        display: flex;
        flex-direction: column;
        align-items: space-around;
        justify-content: space-evenly;
        margin-left: 1rem;
        height: 100%;
        flex: 8;
    }
    .title{
        font-size: calc(0.22 * var(--event-size));
        font-weight: bold;
    }
    .location{
        font-size: calc(0.13 * var(--event-size));
        color: inherit;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        width: fit-content;
        text-decoration: none;
    }
    .location:hover,
    .location:focus-visible{
        color: var(--faff-orange);
        text-decoration: underline;
    }
    .location-icon{
        width: var(--event-font-size);
        height: var(--event-font-size);
        fill: none;
        stroke: currentColor;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-width: 2;
    }
    .description{
        font-size: calc(0.10 * var(--event-size));
    }
    .w2{
        background-color: red;
        height: 100%;
        flex: 2;
    }
    </style>