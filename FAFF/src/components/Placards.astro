---
import Placard from './Placard.astro';
import type { ImageMetadata } from 'astro';

// 1. We tell TypeScript that this glob returns an ImageMetadata object
const imageModules = import.meta.glob<ImageMetadata>('../assets/placards/*.{png,jpg,jpeg,webp,avif,gif,svg}', {
  eager: true,
  import: 'default',
});

const images = Object.entries(imageModules).map(([path, meta]) => ({
  // 2. We extract the actual string URL (.src) from the metadata object
  src: meta.src, 
  alt: path.split('/').pop()?.replace(/\.[^.]+$/, '') ?? 'placard image',
}));
---
<div class="container">
  <div class="wrapper">
    {images.map((image) => (
      <Placard imageSrc={image.src} imageAlt={image.alt} />
    ))}
  </div>
</div>
<style>
.container{
    position: relative;
    width: 100%;
    height: 100%;
    margin-top: 10%;
    justify-content: center;
    align-items: center;
}
.wrapper{
    width: 100%;
    height: 100%;
    display: flex;
    flex-wrap: wrap;
}
  
  </style>