---
const navItems = [
  { name: 'Foods', href: 'equipment' },
  { name: 'Amusements', href: '/amusements' },
  { name: 'About Us', href: '/about' },
  { name: 'Upcoming Events', href: '/upcoming' },
];
const leftItems = navItems.slice(0, 3);
const rightItems = navItems.slice(3);
import ContactButton from './ContactButton.astro';
---

<div class="header">
  <nav class="header-item nav-items-left hide-on-mobile" aria-label="Primary navigation">
    {
      leftItems.map((item) => (
        <a href={item.href} data-name={item.name}>
          {item.name}
        </a>
      ))
    }
  </nav>

  <div class="logo">
    <a href="/">
      <img src="fafficon.svg" alt="Fahie Amusements & Fair Foods home" />
    </a>
  </div>
  <nav class="header-item nav-items-right hide-on-mobile" aria-label="Secondary navigation">
    {
      rightItems.map((item) => (
        <a href={item.href} data-name={item.name}>
          {item.name}
        </a>
      ))
    }
    <ContactButton href="#contact-form" class="hide-on-mobile">Contact us!</ContactButton>
  </nav>

  <nav class="nav-items show-on-mobile">
    {
      navItems.map((item) => (
        <a href={item.href} data-name={item.name}>
          {item.name}
        </a>
      ))
    }
  </nav>

  <style>
    .logo{
      
    }
    .logo img {
      height: 8rem;
      width: auto;
    }
    .header {
      top: 0;
      position: absolute;
      font-family: var(--comfortaa);
      font-size: 1.5rem;
      display: flex;
      width: 100%;
      align-items: center;
      justify-content: center;
      z-index: 999;
    }

    .header-item {
      display: flex;
      align-items: center;
    }

    .nav-items-left,
    .nav-items-right
     {
      flex: 1;
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .nav-items{
      display: flex;
      flex-direction: row;
      justify-content: center;
      align-items: center;
    }


    a {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      color: #fff;
      padding: 0.5em;
      margin: 1em;
      transition: transform 0.2s ease;
    }

    a[data-name='Foods'] {
      --glow-color: red;
    }
    a[data-name='Amusements'] {
      --glow-color: orange;
    }
    a[data-name='Upcoming Events'] {
      --glow-color: rgb(0, 255, 0);
    }
    a[data-name='About Us'] {
      --glow-color: rgb(0, 0, 255);
    }

    a::after {
      z-index: -1;
      content: attr(data-name);
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: inherit;
      box-sizing: border-box;
      animation: pulse 5s infinite;
      opacity: 0;
      transition: opacity 0.4s ease-in-out;
      pointer-events: none;
    }

    a:hover::after {
      opacity: 1;
    }

    a:hover {
      transform: scale(1.05);
    }
    .show-on-mobile {
      display: none;
    }
    @media (max-width: 600px) {
      .header {
        padding-top: 1rem;
        font-size: 3rem;
      }
      a {
        margin: 0.5em;
      }
      .hide-on-mobile {
        display: none;
      }
      .show-on-mobile {
        display: flex;
      }
    }
    

    @keyframes pulse {
      0%,
      74%,
      79%,
      81%,
      100% {
        text-shadow:
          0 0 5px var(--glow-color),
          0 0 10px var(--glow-color),
          0 0 20px var(--glow-color),
          0 0 40px var(--glow-color),
          0 0 60px var(--glow-color);
      }
      75%,
      80% {
        text-shadow: none;
        color: rgba(255, 255, 255, 0.6);
      }
    }
  </style>
</div>
