---
interface Props {
  title: string;
  separate?: boolean;
}
const { title, separate = false } = Astro.props;
---

<div class="container">
  <div class="wrapper">
    <div class="title">{title}</div>
    {separate && <div class="separator"></div>}
  </div>
</div>

<style>
  .container {
    z-index: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    color: rgb(240, 233, 233);
    text-shadow: 0 0 5px var(--faff-orange),
                 0 0 10px var(--faff-orange),
                 0 0 15px var(--faff-orange);
  }
  .wrapper {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: left;
    gap: 0.5rem;
    width: 100%;
  }
  .title {
    font-size: var(--fs4);
    font-weight: 400;
    padding: 0 0 0 1rem;
    text-transform: uppercase;
  }
  .separator {
    width: 100%;
    height: 1px;
    border-radius: 1px;
    background-color: rgb(252, 141, 100);
    box-shadow: 0 0 5px var(--faff-orange),
                 0 0 10px var(--faff-orange),
                 0 0 15px var(--faff-orange);
  }
  </style>