---
import ContactForm from '../components/ContactForm.astro';
---

<div class="container">
    <div class="wrapper">
        <ContactForm />
    </div>
</div>


<style>
    .container{
        position: relative;
        top: -10%;
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    .wrapper{
        width: 100%;
        height: 100%;
        border-radius: 40px;
        display: flex;
        justify-content: center;
        align-items: center;
        /* background-color: var(--bg-blue); */
    }

    @media (max-width:600px) {
       .wrapper{
        width: 90%;
        border-radius: 20px;
    }
    .container{
        margin-top: 35%;
    }
    }
</style>