---
import ContactForm from '../components/ContactForm.astro';
---

<div class="container">
    <div class="wrapper">
        <ContactForm />
    </div>
</div>


<style>
    .container{
        position: relative;
        top: 0%;
        width: 100%;
        height: min-content;
        display: flex;
        justify-content: center;
        align-items: top;
    }
    .wrapper{
        width: 100%;
        height: 100%;
        border-radius: 40px;
        display: flex;
        justify-content: center;
        align-items: center;
        /* background-color: var(--bg-blue); */
    }
    @media (min-width:1200px){
        .container{
            top: -10vw;
            font-size: 1.6rem;
        }
    }
    @media (max-width:600px) {
       .wrapper{
        width: 100%;
        border-radius: 20px;
    }
    .container{
        margin-top: -35%;
    }
    }
    @media (max-width:400px) {
        .container{
            margin-top: -60%;
        }
    }
</style>