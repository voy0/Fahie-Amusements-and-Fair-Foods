---
import Event from '../components/Event.astro';
import { getCollection } from 'astro:content';
import TitleComponent from '../components/TitleComponent.astro';

const allEvents = await getCollection('events');
const events = allEvents.sort((a: any, b: any) =>
    new Date(a.data.date).valueOf() - new Date(b.data.date).valueOf()
);

const getDateParts = (dateInput: Date | string) => {
    const dateObj = new Date(dateInput);
    return {
        month: dateObj.toLocaleDateString('en-US', { month: 'short' }).toUpperCase(),
        day: dateObj.getDate(),
    };
};

const now = new Date();
const firstUpcomingIndex = events.findIndex((event) => new Date(event.data.date) >= now);
---

<div class="container">
    <div class="wrapper">
        {
            events.map((event: any, index: number) => {
                const { month, day } = getDateParts(event.data.date);
                const eventDate = new Date(event.data.date);
                const currentYear = eventDate.getFullYear();
                const previousYear = index > 0 ? new Date(events[index - 1].data.date).getFullYear() : null;
                const showYearTitle = index === 0 || currentYear !== previousYear;
                const isPast = eventDate < now;
                const isNextUpcoming = index === firstUpcomingIndex;

                return (
                    <>
                        {showYearTitle && <TitleComponent title={String(currentYear)} separate />}
                        <Event
                            title={event.data.title}
                            month={month}
                            day={day}
                            hoursFrom={event.data.hoursFrom}
                            hoursTo={event.data.hoursTo}
                            locationName={event.data.locationName}
                            mapUrl={event.data.mapUrl}
                            description={event.data.description}
                            variant={isPast ? 'past' : isNextUpcoming ? 'upcoming-next' : 'upcoming'}
                        />
                    </>
                );
            })
        }
    </div>
</div>

<style>
    .wrapper {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        justify-content: center;
        align-items: center;
        width: 30%;
        background-color: var(--bg-blue);
        height: auto;
    }
    .container {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 3rem 0;
    }
    @media (max-width: 1200px) {
        .wrapper {
            width: 40%;
        }
    }
    @media (max-width: 600px) {
        .wrapper {
            width: 60%;
        }

    })
</style>