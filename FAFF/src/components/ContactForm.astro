---
import ContactButton from './ContactButton.astro'

---
<div id="contact-form" class="wrapper">
  <div class="contact-container">
    <div class="form-column">
      <form id="contact-form-id" class="contact-form" action="https://api.web3forms.com/submit" method="POST" novalidate>
          <input type="hidden" name="access_key" value="53406a58-4b9c-4851-854a-7cd3806f89f4">

        <div class="headline">
          <h2>Contact us</h2>
          <span>Fill out the form and we'll get back to you shortly.</span>
        </div>

        <div class="fields-wrapper">
          <div class="field-wrapper">
            <label class="label" for="name-tf">Name</label>
            <div class="separator" aria-hidden="true"></div>
            <div class="textfield">
              <input type="text" name="name" id="name-tf" placeholder="Your full name" required />
            </div>
          </div>

          <div class="field-wrapper">
            <label class="label" for="email-tf">E-mail</label>
            <div class="separator" aria-hidden="true"></div>
            <div class="textfield">
              <input type="email" name="email" id="email-tf" placeholder="you@example.com" required />
            </div>
          </div>

          <div class="field-wrapper">
            <label class="label" for="phone-tf">Phone</label>
            <div class="separator" aria-hidden="true"></div>
            <div class="textfield">
              <input type="tel" name="phone" id="phone-tf" placeholder="(555) 555-5555" required />
            </div>
          </div>

          <div class="field-wrapper lg-field-wrapper">
            <label class="label" for="message-tf">What's it about</label>
            <div class="separator" aria-hidden="true"></div>
            <div class="textfield">
              <textarea name="message" id="message-tf" rows="5" placeholder="Tell us a little about your inquiry"></textarea>
            </div>
          </div>

          
        </div>
      </form>
    </div>

    <aside class="info-column" aria-label="Business contact">
      <div class="owner-card">
        <h3>Devin Fahie</h3>
        <p class="owner-name">Owner</p>
        <p class="owner-phone"><a href="tel:+15555555555">(555) 555-5555</a></p>

        <p class="note">Contact me for any inquiries.</p>
      </div>
      <div class="actions">
            <ContactButton type="submit" form="contact-form-id">Send message</ContactButton>
          </div>
    </aside>
  </div>
</div>

<script>
  const form = document.querySelector('#contact-form-id');
  const formWrapper = document.querySelector('#contact-form');
  const fields = [
    document.querySelector('#name-tf'),
    document.querySelector('#email-tf'),
    document.querySelector('#phone-tf'),
  ].filter((field): field is HTMLInputElement => field instanceof HTMLInputElement);
  const isValidField = (field: HTMLInputElement) => {
    const value = field.value.trim();

    if (field.id === 'name-tf') {
      return value.length > 0;
    }

    if (field.id === 'email-tf') {
      return field.validity.valid && value.length > 0;
    }

    if (field.id === 'phone-tf') {
      return /^(?:\+?1[\s.-]?)?(?:\([2-9]\d{2}\)|[2-9]\d{2})[\s.-]?[2-9]\d{2}[\s.-]?\d{4}$/.test(value);
    }

    return true;
  };

  const setFieldValidity = (field: HTMLInputElement, isValid: boolean) => {
    field.classList.toggle('field-invalid', !isValid);
    field.setAttribute('aria-invalid', String(!isValid));
  };

  if (form && formWrapper) {
    form.addEventListener('submit', (event) => {
      let hasErrors = false;
      let firstInvalidField: HTMLInputElement | undefined;

      fields.forEach((field) => {
        const isValid = isValidField(field);
        setFieldValidity(field, isValid);

        if (!isValid) {
          hasErrors = true;
          firstInvalidField ??= field;
        }
      });

      formWrapper.classList.toggle('has-errors', hasErrors);

      if (hasErrors) {
        event.preventDefault();
        firstInvalidField?.focus();
      }
    });

    fields.forEach((field) => {
      field.addEventListener('input', () => {
        const isValid = isValidField(field);
        setFieldValidity(field, isValid);

        const hasErrors = fields.some((currentField) => !isValidField(currentField));
        formWrapper.classList.toggle('has-errors', hasErrors);
      });
    });
  }
</script>

<style>
  :root{
    --accent1: rgba(40, 49, 171, 0.485);
    --accent2: rgba(177, 90, 40, 0.571);
    
    --form-scale: 1;
  }
  
  .wrapper{
    z-index: 100;
    min-width: calc(40% * var(--form-scale));
    max-width: calc(70% * var(--form-scale));
    height: calc(40% * var(--form-scale));
    border-radius: 1.25rem;
    border: 1px solid var(--faff-orange);
    background-color: var(--faff-darkblue);
    /* background: linear-gradient(180deg, var(--accent1), var(--accent2)); */
    padding: 2rem;
    font-size: var(--fs2);
    box-shadow: 0 6px 18px rgba(0,0,0,0.08);
    box-sizing: border-box;
  }

  .wrapper.has-errors {
    border-color: #ff1a1a;
    box-shadow:
      0 0 0.5rem #ff1a1a,
      0 0 1.5rem rgba(255, 0, 0, 0.9),
      0 6px 18px rgba(0, 0, 0, 0.08);
  }

  .contact-container{
    display: flex;
    gap: 1.25rem;
    align-items: stretch;
    min-width: 0;
  }

  .form-column{ 
    flex: 1 1 60%;
    min-width: 0;
    box-sizing: border-box;
    background: linear-gradient(180deg, var(--accent1), var(--accent2));
    border-radius: 0.75rem;
    padding: 1.5rem;  
  }

  .headline{
    margin-bottom: 3.5rem;
  }
  .headline h2{
    font-size: var(--fs3);
    margin: 1rem 0 1rem 0;
    color: #fff;
  }

  .headline span{
    font-size: var(--fs2);
    margin: 1rem 0;
    color: rgba(255,255,255,0.95);
  }

  .fields-wrapper{
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.75rem;
    width: 100%;
  }

  /* grid layout so inputs scale with column width */
  .field-wrapper{
    display: grid;
    grid-template-columns: 10% 1.2rem 1fr;
    align-items: start;
    gap: 0.6rem;
    padding: 0.25rem 0;
  }

  /* separator is a slim block between label and input; stretch to row height */
  .separator{
    background: var(--faff-orange);
    width: 0.18rem;
    border-radius: 0.18rem;
    justify-self: center;
    align-self: stretch;
    margin: 0.25rem 0;
  }

  .label{
    font-size: var(--fs2);
    font-weight: 400;
    color: #fff;
    align-self: center;
    justify-self: center;
    text-align: center;
  }

  .textfield{
    width: 100%;
    min-width: 0; /* allow inputs to shrink inside grid */
  }

  .textfield input,
  .textfield textarea{
    width: 100%;
    padding: 1rem 1rem;
    border-radius: 0.5rem;
    border: 1px solid transparent;
    background-color: var(--faff-darkblue);
    color: #fff;
    font-size: var(--fs2);
    box-sizing: border-box;
    min-width: 0;
  }

  .textfield textarea{ max-width:100%; resize:none; }

  .textfield input::placeholder,
  .textfield textarea::placeholder{
    color: rgba(255,255,255,0.6);
  }

  .textfield input:focus,
  .textfield textarea:focus{
    outline: none;
    border-color: rgba(255,255,255,0.18);
    /* box-shadow: 0 0 0 4px rgba(255,165,0,0.06); */
  }

  .textfield input.field-invalid {
    border-color: #ff1a1a;
    box-shadow:
      0 0 0.4rem #ff1a1a,
      0 0 1rem rgba(255, 0, 0, 0.9);
  }

  .actions{ display:flex; justify-content: center; 
   }
  /* adjust ContactButton spacing inside actions */
  .actions :is(button, .button, a){
    margin: 0;
    font-size: var(--fs3);
    width: max-content;
  }

  .info-column{
    flex: 1 1 35%;
    width: auto;
    min-width: 0;
    box-sizing: border-box;
    display:flex;
    align-items:center;
    justify-content:center;
    flex-wrap: wrap;
  }

  .owner-card{
    background: linear-gradient(180deg, var(--accent1), var(--accent2));
    border-radius: 0.75rem;
    padding: 1rem;
    width: 100%;
    max-width: 100%;
    color: #fff;
    box-sizing: border-box;
    overflow-wrap: anywhere;
  }

  .actions {
    width: 100%;
    min-width: 0;
  }

  .actions :is(button, .button, a) {
    max-width: 100%;
    box-sizing: border-box;
  }

  .owner-card h3{ margin:0 0 0.5rem 0; color:rgba(255,255,255,0.9); }
  .owner-name{ font-weight:400; margin:0 0 0.35rem 0; }
  .owner-phone a{ color: var(--faff-orange); font-weight:700; text-decoration:none; }
  .note{ margin-top:0.6rem; color: rgba(255,255,255,0.9);  }
  label {font-size: var(--fs1);}

  @media (max-width: 600px){
    .actions :is(button, .button, a) {
      font-size: var(--fs4);
    }
    .wrapper{ width: 100%;
    font-size: var(--fs5);
  padding: 2rem;}
    .headline h2 {
      font-size: var(--fs5);
    }
    .headline span{
      font-size: var(--fs4);
    }
    .contact-container{ flex-direction:column; }
    .form-column, .info-column{
      flex: 0 1 100%;
      width: 100%;
      max-width: 100%;
    }
    .form-column{
      font-size: var(--fs5);
    }
    .field-wrapper{ grid-template-columns: 1fr;  }
    .field-wrapper *{font-size: var(--fs5);}
    .separator{ display:none; }
    .label{ margin-bottom:0.25rem; justify-self:start; }
    .info-column{flex-wrap:nowrap;}
    .actions{flex: 1 1 100%; justify-content:center; }
    .textfield input,
  .textfield textarea{
    font-size: var(--fs5);
  }
  }
</style>
