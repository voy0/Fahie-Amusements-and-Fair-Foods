---
import ContactButton from './ContactButton.astro'

---
<div class="wrapper">
  <div class="contact-container">
    <div class="form-column">
      <form class="contact-form" action="#" method="post" novalidate>
        <div class="headline">
          <h2>Contact us</h2>
          <span>Fill out the form and we'll get back to you shortly.</span>
        </div>

        <div class="fields-wrapper">
          <div class="field-wrapper">
            <label class="label" for="name-tf">Name</label>
            <div class="separator" aria-hidden="true"></div>
            <div class="textfield">
              <input type="text" name="name" id="name-tf" placeholder="Your full name" required />
            </div>
          </div>

          <div class="field-wrapper">
            <label class="label" for="email-tf">E-mail</label>
            <div class="separator" aria-hidden="true"></div>
            <div class="textfield">
              <input type="email" name="email" id="email-tf" placeholder="you@example.com" required />
            </div>
          </div>

          <div class="field-wrapper">
            <label class="label" for="phone-tf">Phone</label>
            <div class="separator" aria-hidden="true"></div>
            <div class="textfield">
              <input type="tel" name="phone" id="phone-tf" placeholder="(555) 555-5555" pattern="[0-9()+\s-]*" />
            </div>
          </div>

          <div class="field-wrapper lg-field-wrapper">
            <label class="label" for="message-tf">What's it about</label>
            <div class="separator" aria-hidden="true"></div>
            <div class="textfield">
              <textarea name="message" id="message-tf" rows="5" placeholder="Tell us a little about your inquiry" required></textarea>
            </div>
          </div>

          
        </div>
      </form>
    </div>

    <aside class="info-column" aria-label="Business contact">
      <div class="owner-card">
        <h3>Owner</h3>
        <p class="owner-name">Fahie Amusements &amp; Fair Foods</p>
        <p class="owner-phone"><a href="tel:+15555555555">(555) 555-5555</a></p>

        <p class="note">Feel free to call for urgent inquiries or use the form for detailed requests.</p>
      </div>
      <div class="actions">
            <ContactButton type="submit">Send message</ContactButton>
          </div>
    </aside>
  </div>
</div>

<style>
  :root{
    --accent1: rgba(46, 53, 153, 0.6);
    --accent2: rgba(23, 27, 85, 0.349);
  }
  .wrapper{
    width: 60%;
    border-radius: 1.25rem;
    background-color: var(--faff-blue);
    background: linear-gradient(180deg, var(--accent1), var(--accent2));
    padding: 1.25rem;
    box-shadow: 0 6px 18px rgba(0,0,0,0.08);
  }

  .contact-container{
    display: flex;
    gap: 1.25rem;
    align-items: stretch;
  }

  .form-column{ flex: 0 0 60%; }
  .info-column{ flex: 0 0 40%; }

  .headline h2{
    font-size: 1.5rem;
    margin: 1rem 0 1rem 0;
    color: #fff;
  }

  .headline span{
    font-size: 0.98rem;
    margin: 1rem 0;
    color: rgba(255,255,255,0.95);
  }

  .fields-wrapper{
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.75rem;
    width: 100%;
  }

  /* grid layout so inputs scale with column width */
  .field-wrapper{
    display: grid;
    grid-template-columns: 20% 1.2rem 1fr;
    align-items: start;
    gap: 0.6rem;
    padding: 0.25rem 0;
  }

  /* separator is a slim block between label and input; stretch to row height */
  .separator{
    background: var(--faff-orange);
    width: 0.18rem;
    border-radius: 0.18rem;
    justify-self: center;
    align-self: stretch;
    margin: 0.25rem 0;
  }

  .label{
    font-size: 0.95rem;
    color: #fff;
    align-self: center;
    justify-self: center;
  }

  .textfield{
    width: 100%;
    min-width: 0; /* allow inputs to shrink inside grid */
  }

  .textfield input,
  .textfield textarea{
    width: 100%;
    padding: 0.55rem 0.75rem;
    border-radius: 0.5rem;
    border: 1px solid transparent;
    background-color: var(--faff-darkblue);
    color: #fff;
    font-size: 0.95rem;
    box-sizing: border-box;
    min-width: 0;
  }

  .textfield textarea{ max-width:100%; resize:vertical; }

  .textfield input::placeholder,
  .textfield textarea::placeholder{
    color: rgba(255,255,255,0.6);
  }

  .textfield input:focus,
  .textfield textarea:focus{
    outline: none;
    border-color: rgba(255,255,255,0.18);
    /* box-shadow: 0 0 0 4px rgba(255,165,0,0.06); */
  }

  .actions{ display:flex; justify-content:flex-end; margin-top:0.5rem; }
  /* adjust ContactButton spacing inside actions */
  .actions :is(button, .button){
    margin: 0;
    font-size: 1.1em;
  }

  .info-column{
    display:flex;
    align-items:center;
    justify-content:center;
    flex-wrap: wrap;
  }

  .owner-card{
    background: linear-gradient(180deg, var(--accent1), var(--accent2));
    border-radius: 0.75rem;
    padding: 1rem;
    margin-right: 1rem;
    width: 100%;
    color: #fff;
    box-sizing: border-box;
  }

  .owner-card h3{ margin:0 0 0.5rem 0; font-size:1rem; color:rgba(255,255,255,0.9); }
  .owner-name{ font-size:1.125rem; font-weight:700; margin:0 0 0.35rem 0; }
  .owner-phone a{ color: var(--faff-orange); font-weight:700; text-decoration:none; }
  .note{ margin-top:0.6rem; color: rgba(255,255,255,0.9); font-size:0.95rem; }

  @media (max-width: 880px){
    .wrapper{ width: 70%; }
    .contact-container{ flex-direction:column; }
    .form-column, .info-column{ flex: 0 1 100%; }
    .field-wrapper{ grid-template-columns: 1fr; }
    .separator{ display:none; }
    .label{ margin-bottom:0.25rem; justify-self:start; }
    .info-column{flex-wrap:nowrap;}
    .actions{flex: 1 1 100%; justify-content:center;}
  }
</style>
