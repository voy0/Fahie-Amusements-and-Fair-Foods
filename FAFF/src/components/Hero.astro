---
// src/components/Hero.astro
import { getImage } from 'astro:assets';

import mobileBg from '../assets/hero-mobile.jpg';
import desktopBg from '../assets/hero-desktop.jpg';
import HeroBackground from './HeroBackground.astro';
import HeroTagline from './HeroTagline.astro';

const mobileImg = await getImage({ src: mobileBg, format: 'webp', width: 600 });
const desktopImg = await getImage({
  src: desktopBg,
  format: 'webp',
  width: 1920,
});
---

<HeroBackground/>
<HeroTagline/>

