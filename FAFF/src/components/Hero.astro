---
// src/components/Hero.astro
import { getImage } from 'astro:assets';

import mobileBg from '../assets/hero-mobile.jpg';
import desktopBg from '../assets/hero-desktop.jpg';

const mobileImg = await getImage({ src: mobileBg, format: 'webp', width: 600 });
const desktopImg = await getImage({
  src: desktopBg,
  format: 'webp',
  width: 1920,
});
---

<div class="hero-wrapper">
  <div class="hero-background">
  <picture class="hero-image">
    <source media="(max-width: 600px)" srcset={mobileImg.src} />

    <img
      src={desktopImg.src}
      alt="Fahie Amusements and Fairfoods at night, with fireworks"
      width={desktopImg.attributes.width}
      height={desktopImg.attributes.height}
      loading="lazy"
      decoding="async"
    />
  </picture>
  <div class="hero-gradient" id="hero-gradient1"></div>
  <div class="hero-gradient" id="hero-gradient2"></div>
  </div>
  <div class="tagline-container">
    <div class="tagline-wrapper">
    <h1 class="tagline">Real Carnival Expirience </br>at Your Event</h1>
    <h3 class="subtext">Family owned show. </br> Just for <span>your</span> needs.</h3>
    </div>
  </div>
</div>
<style>  
.hero-background{
  position: fixed;
}
.tagline-container{
  position: inherit;
  top:0;
  left: 0;
  height: 60vw;
  width: 100%;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.8rem;
}
.tagline-wrapper{
  
}
.tagline{
  text-align: center;
  line-height: 150%;
  font-weight: lighter;
  font-family: var(--coiny);
   text-shadow: 0 0 5px var(--faff-orange),
   0 0 10px var(--faff-orange),
  0 0 15px var(--faff-orange);
}
.subtext{
  margin-top: 10%;
  font-weight: 100;
  line-height: 150%;
  font-size: 1em;
  font-family: var(--comfortaa);
  text-align: center;
}
.subtext span{
  color: var(--faff-orange);
}
.hero-image{
    display: block;
    width: 100%;
    height: 100%; 
  }
  @media (max-width: 600px) {
    .tagline-container{
      font-size: 3rem;
      margin-top: 70%;
      position: relative;
      top: 50%;
    }
  }
  .hero-wrapper {
    position: relative; 
    width: 100vw; 
    height: auto; 
    overflow-x: hidden;
  }
  .hero-image{
    display: block;
    width: 100%;
    height: 100%; 
  }
  .hero-image img {
    width: 100%;
    height: 100%;
    
    object-fit: cover;
    object-position: 50% 50%;
  }
  .hero-gradient {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;

    pointer-events: none;
    z-index: 1;
  }
  #hero-gradient1 {
    background: linear-gradient(
      to right,
      rgb(0, 0, 0) 1%,
      rgba(0, 0, 0, 0) 35%,
      rgba(0, 0, 0, 0) 50%,
      rgba(0, 0, 0, 0) 65%,
      rgb(0, 0, 0) 99%
    );
  }
  #hero-gradient2 {
    background: linear-gradient(
      to top,
      rgb(0, 0, 0) 0%,
       rgba(0, 0, 0, 0) 35%,
      rgba(0, 0, 0, 0) 50%,
      rgba(0, 0, 0, 0) 85%,
      rgba(0, 0, 0) 100%
    );
  }
  
</style>
